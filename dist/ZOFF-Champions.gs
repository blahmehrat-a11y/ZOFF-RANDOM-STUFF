t type=\"radio\" name=\"brand\" id=\"br-${b}\" value=\"${b}\" ${i === 0 ? \"checked\" : \"\"}>${b}</label>`).join(\"\")}</div></fieldset>\n    </div>\n    <div class=\"panel stack\" data-show=\"ENGAGEMENT\">\n      <label for=\"f-post\">Post link <span class=\"hint\">The daily link Marketing shared</span><input type=\"url\" id=\"f-post\" placeholder=\"https://www.instagram.com/p/…\"></label>\n      ${c.posts.length ? `<select id=\"f-postpick\" aria-label=\"Pick a recent post\"><option value=\"\">Or pick a recent post…</option>${c.posts.map((p) => `<option value=\"${esc(p.url)}\">${esc(p.date)} · ${esc(p.brand)} · ${esc(p.label || p.key)}</option>`).join(\"\")}</select>` : \"\"}\n      <fieldset><legend>What did you do? <span class=\"muted\" style=\"font-weight:400\">Each counts once per post</span></legend>${c.engagement.map((a) => opt(\"act\", \"checkbox\", a)).join(\"\")}</fieldset>\n      <label for=\"f-replies\">Helpful WhatsApp replies <span class=\"hint\">Separate conversations where you answered a real question · 5 points each</span><input type=\"number\" id=\"f-replies\" min=\"0\" max=\"50\" value=\"0\" inputmode=\"numeric\"></label>\n    </div>\n    <div class=\"panel stack\" data-show=\"ORIGINAL\">\n      <fieldset><legend>What did you create?</legend>${c.original.map((a, i) => opt(\"otype\", \"radio\", a, i === 0)).join(\"\")}</fieldset>\n      <label for=\"f-desc\">Describe it in one line<input type=\"text\" id=\"f-desc\" maxlength=\"300\"></label>\n      <label for=\"f-link\">Or a Drive link to the clean file <span class=\"hint\">Use this for big videos instead of uploading</span><input type=\"url\" id=\"f-link\" placeholder=\"https://drive.google.com/…\"></label>\n      <label class=\"opt\" for=\"f-mine\"><input type=\"checkbox\" id=\"f-mine\"><span>I made this myself for this programme, beyond my assigned work, and it is not a re-edit of something I already entered.</span></label>\n    </div>\n    <div class=\"panel stack\" data-show=\"QUORA\">\n      <label for=\"f-quora\">Quora answer link<input type=\"url\" id=\"f-quora\" placeholder=\"https://www.quora.com/…/answer/…\"></label>\n      <label class=\"opt\" for=\"f-disclose\"><input type=\"checkbox\" id=\"f-disclose\"><span>My answer says I work at ZOFF and reflects my own experience.</span><span class=\"pts\">20</span></label>\n    </div>\n    <div class=\"panel stack\" data-show=\"ENGAGEMENT ORIGINAL\">\n      <label for=\"f-files\"><span data-show=\"ENGAGEMENT\">Screenshots</span><span data-show=\"ORIGINAL\">The clean file</span> <span class=\"hint\">Up to 20 MB in total</span>\n        <input type=\"file\" id=\"f-files\" multiple accept=\"image/*,video/*,application/pdf\"></label>\n      <p class=\"filelist\" id=\"f-filelist\"></p>\n      <label for=\"f-proof\">Proof links <span class=\"hint\">Optional. Links to your comment or share, one per line.</span><textarea id=\"f-proof\"></textarea></label>\n    </div>\n    <div class=\"row\"><button class=\"primary\" type=\"submit\" id=\"f-submit\">Send for review</button><span class=\"muted small\" id=\"f-claim\"></span></div>\n    <p class=\"small\" id=\"f-error\" style=\"color:var(--bad)\" role=\"alert\"></p>\n  </form>`;\n}\n\nfunction syncForm() {\n  document.querySelectorAll(\"[data-show]\").forEach((el) => (el.hidden = !el.dataset.show.split(\" \").includes(S.type)));\n  const a = S.cfg.actions; let pts = 0;\n  if (S.type === \"ENGAGEMENT\") {\n    document.querySelectorAll(\"input[name=act]:checked\").forEach((c) => (pts += a[c.value].points));\n    pts += Math.max(0, Math.min(50, Math.floor(Number($(\"#f-replies\").value) || 0))) * a.HELPFUL_REPLY.points;\n  } else if (S.type === \"ORIGINAL\") { const o = document.querySelector(\"input[name=otype]:checked\"); pts = o ? a[o.value].points : 0; }\n  else pts = a.QUORA_ANSWER.points;\n  $(\"#f-claim\").textContent = pts ? `Up to ${pts} points once approved` : \"\";\n  const files = [...($(\"#f-files\").files || [])];\n  $(\"#f-filelist\").textContent = files.map((f) => `${f.name} (${(f.size / 1048576).toFixed(1)} MB)`).join(\", \");\n}\n\nconst readFile = (f) => new Promise((res, rej) => { const r = new FileReader(); r.onload = () => res({ name: f.name, mimeType: f.type, data: String(r.result).split(\",\")[1] }); r.onerror = rej; r.readAsDataURL(f); });\n\nasync function submit(ev) {\n  ev.preventDefault();\n  const err = $(\"#f-error\"); err.textContent = \"\";\n  const files = [...($(\"#f-files\").files || [])];\n  if (files.reduce((s, f) => s + f.size, 0) > 20 * 1048576) { err.textContent = \"Files are over 20 MB. Upload fewer, or paste a Drive link instead.\"; return; }\n  const p = { entryType: S.type, brand: (document.querySelector(\"input[name=brand]:checked\") || {}).value, proofLinks: $(\"#f-proof\").value };\n  if (S.type === \"ENGAGEMENT\") {\n    p.postUrl = $(\"#f-post\").value.trim();\n    p.actions = [...document.querySelectorAll(\"input[name=act]:checked\")].map((c) => c.value);\n    p.helpfulReplies = $(\"#f-replies\").value;\n  } else if (S.type === \"ORIGINAL\") {\n    p.originalType = document.querySelector(\"input[name=otype]:checked\").value;\n    p.description = $(\"#f-desc\").value; p.contentUrl = $(\"#f-link\").value.trim(); p.confirmed = $(\"#f-mine\").checked;\n  } else { p.quoraUrl = $(\"#f-quora\").value.trim(); p.confirmed = $(\"#f-disclose\").checked; }\n  const btn = $(\"#f-submit\"); btn.disabled = true; btn.innerHTML = `<span class=\"spinner\"></span> Sending…`;\n  try {\n    p.files = S.type === \"QUORA\" ? [] : await Promise.all(files.map(readFile));\n    const r = await api(\"apiSubmit\", S.emp.id, S.emp.pin, p);\n    S.mine = r.mine; toast(\"Sent. Marketing will review it.\"); render();\n  } catch (e) {\n    err.textContent = e.message; btn.disabled = false; btn.textContent = \"Send for review\";\n    if (/PIN/.test(e.message)) signOut();\n  }\n}\n\nfunction viewPosts() {\n  const sent = {}; (S.mine ? S.mine.items : []).forEach((i) => i.postKey && (sent[i.postKey] = true));\n  const list = S.cfg.posts;\n  return `<div class=\"stack\">\n    <div><p class=\"eyebrow\">Marketing shares links daily</p><h2>Today's posts</h2><p class=\"muted small\" style=\"margin-top:6px\">Like, comment or share any of these, then send your proof. Each post can earn up to 20 points.</p></div>\n    ${list.length ? `<div class=\"tablebox\"><table><thead><tr><th>Date</th><th>Post</th><th></th></tr></thead><tbody>\n      ${list.map((p) => `<tr><td class=\"num\">${esc(p.date)}</td><td class=\"links\"><b>${esc(p.brand)}</b>${p.label ? \" · \" + esc(p.label) : \"\"}<br><a href=\"${esc(p.url)}\" target=\"_blank\" rel=\"noopener\">${esc(p.key)}</a></td>\n        <td>${sent[p.key] ? `<span class=\"chip ok\">Sent</span>` : `<button class=\"ghost\" data-proof=\"${esc(p.url)}\">Send proof</button>`}</td></tr>`).join(\"\")}\n    </tbody></table></div>` : `<div class=\"panel empty\">No posts yet. Marketing adds each day's ZOFF and Akash links here.</div>`}\n  </div>`;\n}\n\nfunction viewBoard() {\n  const b = S.board;\n  if (!b) { loadBoard(S.boardMonth || S.cfg.month); return `<div class=\"panel empty\"><span class=\"spinner\"></span> Loading the leaderboard…</div>`; }\n  const cut = b.rows.findIndex((r) => !r.qualified);\n  return `<div class=\"stack\">\n    <div class=\"row\" style=\"justify-content:space-between\">\n      <div><p class=\"eyebrow\">One monthly leaderboard</p><h2>${esc(monthLabel(b.month))}</h2></div>\n      <select id=\"boardMonth\" aria-label=\"Month\">${S.cfg.months.map((m) => `<option value=\"${m}\" ${m === b.month ? \"selected\" : \"\"}>${esc(monthLabel(m))}</option>`).join(\"\")}</select>\n    </div>\n    ${b.winners.length ? `<div class=\"notice ok\"><b>Winners confirmed</b></div><div class=\"tablebox\"><table><thead><tr><th>Rank</th><th>Winner</th><th>Prize</th></tr></thead><tbody>\n      ${b.winners.map((w) => `<tr><td class=\"pos\">${esc(w.rank)}</td><td><b>${esc(w.name)}</b></td><td class=\"prize\">${esc(w.prize)}<br><span class=\"muted small\">${esc(w.detail)}${w.useBy ? \" · use by \" + esc(w.useBy) : \"\"}</span></td></tr>`).join(\"\")}</tbody></table></div>`\n      : b.pending ? `<div class=\"notice\">${b.pending} ${b.pending === 1 ? \"entry is\" : \"entries are\"} waiting for review. Scores count approved entries only.</div>` : \"\"}\n    ${b.rows.length ? `<div class=\"tablebox\"><table><thead><tr><th>#</th><th>Name</th><th class=\"n\">Points</th><th class=\"n\">Active days</th><th class=\"n\">Posts</th><th>Prize</th></tr></thead><tbody>\n      ${b.rows.map((r, i) => `<tr class=\"${i === cut && i > 0 ? \"cut\" : \"\"}\"><td class=\"pos\">${r.position || \"\"}</td><td><b>${esc(r.name)}</b>${S.emp && r.name === S.emp.name ? ` <span class=\"chip\">You</span>` : \"\"}</td>\n        <td class=\"n\"><b>${r.points}</b></td><td class=\"n\">${r.activeDays}</td><td class=\"n\">${r.posts}</td>\n        <td>${r.prize ? `<span class=\"prize\">${esc(r.prize)}</span><br><span class=\"muted small\">${esc(r.detail)}</span>` : `<span class=\"muted small\">${r.toQualify} to qualify</span>`}${r.drawPending ? `<br><span class=\"chip warn\">Tied · draw at month end</span>` : \"\"}</td></tr>`).join(\"\")}\n    </tbody></table></div>` : `<div class=\"panel empty\">No approved points for ${esc(monthLabel(b.month))} yet.</div>`}\n    <p class=\"muted small\">${S.cfg.qualify} approved points gets you into the prize ranking. Ties go to more active days, then more different posts, then a recorded draw.</p>\n  </div>`;\n}\n\nasync function loadBoard(month) {\n  try { S.board = await api(\"apiLeaderboard\", month); } catch (e) { S.board = { month, rows: [], winners: [], pending: 0 }; toast(e.message); }\n  if (S.tab === \"board\") render();\n}\n\nfunction viewMine() {\n  const m = S.mine; if (!m) return `<div class=\"panel empty\"><span class=\"spinner\"></span></div>`;\n  const q = S.cfg.qualify; const pct = Math.min(100, (m.points / q) * 100);\n  const groups = new Map(); m.items.forEach((i) => { if (!groups.has(i.responseId)) groups.set(i.responseId, []); groups.get(i.responseId).push(i); });\n  return `<div class=\"stack\">\n    <div class=\"panel stack\">\n      <div><p class=\"eyebrow\">${esc(monthLabel(m.month))}</p><h2>Your points</h2></div>\n      <div class=\"stats\">\n        <div class=\"stat\"><span class=\"muted small\">Approved</span><b>${m.points}</b></div>\n        <div class=\"stat\"><span class=\"muted small\">Waiting for review</span><b>${m.pendingPoints}</b></div>\n        <div class=\"stat\"><span class=\"muted small\">Position</span><b>${m.position ? \"#\" + m.position : \"–\"}</b></div>\n      </div>\n      <div><div class=\"bar\" role=\"img\" aria-label=\"${m.points} of ${q} points to qualify\"><i style=\"width:${pct}%\"></i></div>\n      <p class=\"small muted\" style=\"margin-top:6px\">${m.points >= q ? \"You're in the prize ranking. Keep going: the highest verified scores win.\" : `${q - m.points} more approved points to enter the prize ranking. That's about ${Math.ceil((q - m.points) / 20)} more full posts.`}</p></div>\n    </div>\n    ${groups.size ? `<div class=\"tablebox\"><table><thead><tr><th>Sent</th><th>Status</th></tr></thead><tbody>\n      ${[...groups.values()].map((g) => `<tr><td class=\"num\">${esc(istTime(g[0].at))}${g[0].postKey ? `<br><span class=\"muted small links\">${esc(g[0].postKey)}</span>` : \"\"}</td>\n        <td>${g.map((i) => `<span class=\"chip ${i.status === \"Approved\" ? \"ok\" : i.status === \"Rejected\" ? \"bad\" : \"\"}\">${esc(SHORT[i.action] || i.action)} · ${i.status === \"Approved\" ? (i.counted === 0 ? \"counted already\" : \"+\" + i.points) : esc(i.status)}</span>`).join(\" \")}\n        ${g.filter((i) => i.note).map((i) => `<br><span class=\"small muted\">${esc(i.note)}</span>`).join(\"\")}</td></tr>`).join(\"\")}\n    </tbody></table></div>` : `<div class=\"panel empty\">You haven't sent anything yet. Like, comment on or share a daily post, then use \"Send proof\".</div>`}\n  </div>`;\n}\n\nfunction viewRules() {\n  const c = S.cfg; const a = c.actions;\n  const rows = (codes) => codes.map((k) => `<div>${esc(a[k].label)}</div><div>${a[k].points}</div>`).join(\"\");\n  return `<div class=\"grid2\">\n    <div class=\"stack\">\n      <div class=\"panel stack\"><h2>Daily posts</h2><p class=\"muted small\">Marketing shares links from ZOFF and Akash. The first five actions count once per post.</p>\n        <div class=\"pointsTable\">${rows(c.engagement.concat([\"HELPFUL_REPLY\"]))}</div>\n        <p class=\"muted small\">Friends and groups share one 5-point allowance per post. Helpful replies count once per conversation.</p></div>\n      <div class=\"panel stack\"><h2>Your original content</h2><div class=\"pointsTable\">${rows(c.original.concat([\"QUORA_ANSWER\"]))}</div>\n        <p class=\"muted small\">Made by you. Clear to see or hear. Relevant to ZOFF or Akash. Each original counts once; a new edit or the same post on another channel does not earn again. Google reviews sit outside reward points.</p></div>\n    </div>\n    <div class=\"stack\">\n      <div class=\"panel stack\"><h2>Monthly prizes</h2><p class=\"muted small\">${c.qualify} approved points gets you into the prize ranking. One prize or time-off perk each.</p>\n        <div class=\"tablebox\"><table><tbody>${c.prizes.map((p) => `<tr><td class=\"pos\">${p.rank}</td><td class=\"prize\">${esc(p.name)}</td><td>${esc(p.detail)}</td></tr>`).join(\"\")}</tbody></table></div>\n        <p class=\"muted small\">Ties: more active days, then more different posts supported, then a recorded draw. Time off is used within ${c.timeOffDays} days, with your manager.</p></div>\n      <div class=\"panel stack\"><h2>The monthly rhythm</h2>\n        <p><b>Daily:</b> new post links. <b>Any time:</b> send proof here. <b>Month end:</b> entries close at 11:59 PM IST on the last day. <b>Next month:</b> final scores by working day ${c.workingDays[0]}, queries by day ${c.workingDays[1]}, winners by day ${c.workingDays[2]}. Points reset every month.</p></div>\n    </div>\n  </div>`;\n}\n\nfunction signOut() { S.emp = null; S.mine = null; store.del(\"zc-emp\"); render(); }\n\ndocument.addEventListener(\"click\", (ev) => {\n  const t = ev.target.closest(\"button\"); if (!t) return;\n  if (t.dataset.tab) { S.tab = t.dataset.tab; store.set(\"zc-tab\", S.tab); if (S.tab === \"board\") S.board = null; render(); }\n  else if (t.id === \"signout\") signOut();\n  else if (t.dataset.proof) { S.tab = \"submit\"; S.type = \"ENGAGEMENT\"; render(); if ($(\"#f-post\")) $(\"#f-post\").value = t.dataset.proof; }\n});\ndocument.addEventListener(\"change\", (ev) => {\n  const t = ev.target;\n  if (t.name === \"etype\") { S.type = t.value; syncForm(); }\n  else if (t.id === \"f-postpick\" && t.value) $(\"#f-post\").value = t.value;\n  else if (t.id === \"boardMonth\") { S.boardMonth = t.value; S.board = null; render(); }\n  else if (t.name === \"act\" || t.name === \"otype\" || t.id === \"f-files\") syncForm();\n});\ndocument.addEventListener(\"input\", (ev) => { if (ev.target.id === \"f-replies\") syncForm(); });\ndocument.addEventListener(\"submit\", async (ev) => {\n  if (ev.target.id === \"submitForm\") return submit(ev);\n  if (ev.target.id !== \"signinForm\") return;\n  ev.preventDefault();\n  const id = $(\"#si-id\").value.trim(), pin = $(\"#si-pin\").value.trim();\n  $(\"#si-go\").disabled = true; $(\"#si-err\").textContent = \"\";\n  try { const r = await api(\"apiSignIn\", id, pin); S.emp = { id: r.id, name: r.name, pin }; S.mine = r.mine; store.set(\"zc-emp\", S.emp); render(); }\n  catch (e) { $(\"#si-err\").textContent = e.message; $(\"#si-go\").disabled = false; }\n});\n\n(async function boot() {\n  S.tab = store.get(\"zc-tab\") || \"submit\";\n  try { S.cfg = await api(\"apiConfig\"); } catch (e) { $(\"#view\").innerHTML = `<div class=\"notice bad\">${esc(e.message)}</div>`; return; }\n  const saved = store.get(\"zc-emp\");\n  if (saved && saved.id && saved.pin) {\n    try { S.mine = await api(\"apiMine\", saved.id, saved.pin); S.emp = saved; } catch (e) { store.del(\"zc-emp\"); }\n  }\n  render();\n})();\n</script>\n</body>\n</html>\n",
 "review": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>ZOFF Champions Review Desk</title>\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Bitter:wght@700;800&family=Figtree:wght@400;500;600;700&display=swap\">\n<style>\n/* Layout: one working column, tab strip on top; the leaderboard and review queue are tables that scroll inside their own box. */\n:root {\n  --bg: #fff6e8; --surface: #fffdf8; --ink: #2a211b; --muted: #74655a; --line: #e8d9c4;\n  --orange: #e2470b; --orange-ink: #ffffff; --green: #1f4f44; --gold: #c98a06;\n  --ok: #1d7a45; --warn: #a76100; --bad: #b3261e; --chip: #f6e6cf;\n  --display: \"Bitter\", Georgia, \"Times New Roman\", serif;\n  --body: \"Figtree\", system-ui, -apple-system, \"Segoe UI\", sans-serif;\n}\n@media (prefers-color-scheme: dark) { :root:not([data-theme=\"light\"]) {\n  --bg: #13211d; --surface: #1a2c27; --ink: #f5ecdf; --muted: #b3a797; --line: #2f4640;\n  --orange: #ff6a2c; --orange-ink: #1a0d06; --green: #8fd0bd; --gold: #f5b82e;\n  --ok: #5fd08f; --warn: #f0b04a; --bad: #ff8a80; --chip: #24392f; color-scheme: dark } }\n:root[data-theme=\"dark\"] {\n  --bg: #13211d; --surface: #1a2c27; --ink: #f5ecdf; --muted: #b3a797; --line: #2f4640;\n  --orange: #ff6a2c; --orange-ink: #1a0d06; --green: #8fd0bd; --gold: #f5b82e;\n  --ok: #5fd08f; --warn: #f0b04a; --bad: #ff8a80; --chip: #24392f; color-scheme: dark }\n\nbody.desk .logo { background: var(--green); color: var(--surface); }\nbody.desk .eyebrow#eyebrow { color: var(--green); }\nbody { background: var(--bg); color: var(--ink); font: 15px/1.5 var(--body); }\n.wrap { max-width: 1040px; margin: 0 auto; padding-inline: 16px; padding-block: 20px 60px; }\nh1, h2, h3 { font-family: var(--display); text-wrap: balance; margin: 0; line-height: 1.15; }\nh1 { font-size: clamp(26px, 5vw, 38px); font-weight: 800; }\nh2 { font-size: 22px; font-weight: 800; }\nh3 { font-size: 16px; font-weight: 700; }\np { margin: 0; }\n.eyebrow { font: 700 12px/1 var(--body); letter-spacing: .08em; text-transform: uppercase; color: var(--orange); }\n.muted { color: var(--muted); }\n.small { font-size: 13px; }\n.num { font-variant-numeric: tabular-nums; }\n\nheader.top { display: flex; gap: 16px; align-items: center; justify-content: space-between; flex-wrap: wrap; }\n.brand { display: flex; gap: 14px; align-items: center; }\n.logo { width: 52px; height: 52px; background: var(--orange); color: var(--orange-ink); display: grid; place-items: center; font: 800 15px/1 var(--body); letter-spacing: .02em; flex: none; }\n.who { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }\n.chip { display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: 999px; background: var(--chip); font-size: 13px; font-weight: 600; white-space: nowrap; }\n.chip.ok { color: var(--ok); } .chip.warn { color: var(--warn); } .chip.bad { color: var(--bad); } .chip.gold { color: var(--gold); }\n\nnav.tabs { display: flex; gap: 4px; margin-block: 22px 18px; border-bottom: 2px solid var(--line); overflow-x: auto; }\nnav.tabs button { background: none; border: 0; padding: 10px 14px; font: 600 15px var(--body); color: var(--muted); cursor: pointer; border-bottom: 3px solid transparent; margin-bottom: -2px; white-space: nowrap; }\nnav.tabs button[aria-selected=\"true\"] { color: var(--ink); border-bottom-color: var(--orange); }\nnav.tabs button:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible, a:focus-visible { outline: 3px solid var(--gold); outline-offset: 2px; }\n.badge { display: inline-block; min-width: 20px; padding: 0 6px; border-radius: 999px; background: var(--orange); color: var(--orange-ink); font-size: 12px; line-height: 20px; text-align: center; margin-left: 6px; }\n\n.panel { background: var(--surface); border: 1px solid var(--line); padding: 20px; }\n.stack { display: grid; gap: 16px; }\n.row { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; }\n.grid2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; }\n.grid2 > * { min-width: 0; }\n\nlabel { display: grid; gap: 6px; font-weight: 600; font-size: 14px; }\nlabel .hint { font-weight: 400; color: var(--muted); font-size: 13px; }\ninput[type=text], input[type=url], input[type=number], select, textarea {\n  font: 15px var(--body); color: var(--ink); background: var(--bg); border: 1.5px solid var(--line); padding: 9px 11px; width: 100%; box-sizing: border-box; border-radius: 0; }\ntextarea { min-height: 70px; resize: vertical; }\nfieldset { border: 0; padding: 0; margin: 0; display: grid; gap: 8px; }\nlegend { font-weight: 600; font-size: 14px; margin-bottom: 6px; padding: 0; }\n.opt { display: flex; gap: 10px; align-items: flex-start; font-weight: 500; padding: 9px 11px; border: 1.5px solid var(--line); background: var(--bg); cursor: pointer; }\n.opt input { margin-top: 3px; accent-color: var(--orange); }\n.opt .pts { margin-left: auto; font-weight: 700; color: var(--orange); white-space: nowrap; }\n.seg { display: flex; flex-wrap: wrap; gap: 8px; }\n.seg label { display: flex; flex-direction: row; gap: 8px; align-items: center; padding: 8px 12px; border: 1.5px solid var(--line); background: var(--bg); cursor: pointer; font-weight: 600; }\n.seg input { accent-color: var(--orange); }\n\nbutton.primary, button.secondary, button.ghost { font: 700 15px var(--body); padding: 10px 16px; cursor: pointer; border: 2px solid var(--orange); }\nbutton.primary { background: var(--orange); color: var(--orange-ink); }\nbutton.secondary { background: transparent; color: var(--orange); }\nbutton.ghost { background: transparent; color: var(--ink); border-color: var(--line); padding: 6px 10px; font-size: 13px; }\nbutton:disabled { opacity: .45; cursor: not-allowed; }\n.ok-btn { border-color: var(--ok) !important; color: var(--ok) !important; }\n.bad-btn { border-color: var(--bad) !important; color: var(--bad) !important; }\n.on.ok-btn { background: var(--ok) !important; color: var(--surface) !important; }\n.on.bad-btn { background: var(--bad) !important; color: var(--surface) !important; }\n\n.notice { padding: 12px 14px; border-left: 4px solid var(--gold); background: var(--chip); font-size: 14px; }\n.notice.bad { border-color: var(--bad); }\n.notice.ok { border-color: var(--ok); }\n\n.tablebox { overflow-x: auto; border: 1px solid var(--line); background: var(--surface); }\ntable { border-collapse: collapse; width: 100%; font-size: 14px; }\nth, td { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--line); vertical-align: top; }\nth { font-size: 12px; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); font-weight: 700; background: var(--bg); position: sticky; top: 0; }\ntd.n, th.n { text-align: right; font-variant-numeric: tabular-nums; }\ntr.cut td { border-top: 2px dashed var(--orange); }\n.pos { font: 800 18px var(--display); color: var(--orange); }\n.prize { font-weight: 600; }\n.flag { display: inline-block; font-size: 12px; font-weight: 700; color: var(--bad); margin: 2px 6px 0 0; }\n.links a { color: var(--green); word-break: break-all; }\n\n.stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; }\n.stat { border-top: 3px solid var(--green); padding-top: 8px; }\n.stat b { display: block; font: 800 28px var(--display); font-variant-numeric: tabular-nums; }\n.bar { height: 10px; background: var(--chip); position: relative; margin-top: 8px; }\n.bar i { position: absolute; inset: 0 auto 0 0; background: var(--orange); }\n\n.pointsTable { display: grid; grid-template-columns: 1fr auto; border: 1px solid var(--line); }\n.pointsTable div { padding: 8px 12px; border-bottom: 1px solid var(--line); }\n.pointsTable div:nth-child(even) { text-align: right; font-weight: 700; color: var(--orange); font-variant-numeric: tabular-nums; }\n.toast { position: fixed; left: 50%; transform: translateX(-50%); bottom: calc(20px + env(safe-area-inset-bottom, 0px)); background: var(--ink); color: var(--bg); padding: 10px 16px; font-weight: 600; max-width: calc(100% - 32px); }\n.empty { padding: 28px; text-align: center; color: var(--muted); }\n@media (prefers-reduced-motion: no-preference) { .bar i { transition: width .4s ease; } }\n\n.signin { max-width: 420px; }\n.filelist { font-size: 13px; color: var(--muted); }\n.spinner { display: inline-block; width: 14px; height: 14px; border: 2px solid var(--line); border-top-color: var(--orange); border-radius: 50%; animation: spin .8s linear infinite; vertical-align: -2px; }\n@keyframes spin { to { transform: rotate(360deg); } }\n@media (prefers-reduced-motion: reduce) { .spinner { animation: none; } }\n\n</style>\n</head>\n<body class=\"desk\">\n<div class=\"wrap\">\n  <header class=\"top\">\n    <div class=\"brand\">\n      <div class=\"logo\" aria-hidden=\"true\">ZOFF</div>\n      <div><p class=\"eyebrow\" id=\"eyebrow\">Marketing &amp; HR only</p><h1>Champions Review Desk</h1></div>\n    </div>\n    <div class=\"who\" id=\"who\"></div>\n  </header>\n  <nav class=\"tabs\" role=\"tablist\" id=\"tabs\"></nav>\n  <main id=\"view\"></main>\n</div>\n<div class=\"toast\" id=\"toast\" hidden></div>\n\n<script>\n\"use strict\";\n// Talks to WebApp.js through google.script.run. Every call carries the reviewer passcode.\nconst api = (fn, ...args) => new Promise((resolve, reject) =>\n  google.script.run.withSuccessHandler(resolve).withFailureHandler((e) => reject(new Error((e && e.message) || String(e))))[fn](...args));\n\nconst S = { pass: \"\", name: \"\", cfg: null, tab: \"review\", month: \"\", filter: \"Pending\", queue: null, board: null, confirm: false };\nconst ss = {\n  get(k) { try { return sessionStorage.getItem(k) || \"\"; } catch (e) { return \"\"; } },\n  set(k, v) { try { sessionStorage.setItem(k, v); } catch (e) {} }\n};\nconst $ = (s) => document.querySelector(s);\nconst esc = (s) => String(s == null ? \"\" : s).replace(/[&<>\"']/g, (c) => ({ \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", '\"': \"&quot;\", \"'\": \"&#39;\" }[c]));\nconst monthLabel = (mk) => { const [y, m] = mk.split(\"-\").map(Number); return new Date(Date.UTC(y, m - 1, 15)).toLocaleString(\"en-IN\", { month: \"long\", year: \"numeric\", timeZone: \"UTC\" }); };\nconst istTime = (ms) => new Date(ms).toLocaleString(\"en-IN\", { timeZone: \"Asia/Kolkata\", day: \"numeric\", month: \"short\", hour: \"2-digit\", minute: \"2-digit\" });\nfunction toast(msg) { const t = $(\"#toast\"); t.textContent = msg; t.hidden = false; clearTimeout(toast.h); toast.h = setTimeout(() => (t.hidden = true), 3500); }\nconst SHORT = { LIKE: \"Like\", COMMENT: \"Comment\", SOCIAL_SHARE: \"Share\", WA_STATUS: \"WA Status\", FRIENDS_GROUP: \"Friends/group\", HELPFUL_REPLY: \"Helpful reply\", ORIGINAL_POST: \"Original post\", ORIGINAL_REEL: \"Original Reel\", FACTORY_VIDEO: \"Factory video\", FACTORY_REEL: \"Factory Reel\", QUORA_ANSWER: \"Quora\" };\nconst FLAG_TEXT = { NOT_REGISTERED: \"Not registered\", NO_POST_LINK: \"No post link\", POST_NOT_IN_DAILY_LIST: \"Not in the daily post list\", NO_PROOF: \"No proof\", NO_CLEAN_FILE: \"No clean file uploaded\", EMAIL_DOES_NOT_MATCH_ID: \"Email doesn't match ID\" };\nconst flagText = (f) => FLAG_TEXT[f] || f.replace(/^ALREADY_CLAIMED/, \"Already claimed\").replace(/^SAME_FILE_AS/, \"Same file as\").replace(/^SAME_LINK_AS/, \"Same link as\");\n\nconst TABS = [[\"review\", \"Review\"], [\"posts\", \"Daily posts\"], [\"board\", \"Leaderboard & winners\"]];\n\nfunction render() {\n  $(\"#who\").innerHTML = S.pass ? `<span class=\"chip gold\">${esc(S.name)}</span><button class=\"ghost\" id=\"signout\">Sign out</button>` : \"\";\n  $(\"#tabs\").innerHTML = S.pass ? TABS.map(([k, l]) => `<button role=\"tab\" id=\"tab-${k}\" data-tab=\"${k}\" aria-selected=\"${S.tab === k}\">${l}${k === \"review\" && S.queue && S.queue.pending ? `<span class=\"badge\">${S.queue.pending}</span>` : \"\"}</button>`).join(\"\") : \"\";\n  $(\"#view\").innerHTML = !S.pass ? viewSignIn() : { review: viewReview, posts: viewPosts, board: viewBoard }[S.tab]();\n}\n\nfunction viewSignIn() {\n  return `<form class=\"panel stack signin\" id=\"signinForm\" novalidate>\n    <div><p class=\"eyebrow\">Reviewers</p><h2>Sign in to review</h2>\n    <p class=\"muted small\" style=\"margin-top:6px\">Your name is saved with every decision you make.</p></div>\n    <label for=\"si-name\">Your name<input type=\"text\" id=\"si-name\" autocomplete=\"name\" value=\"${esc(ss.get(\"zc-name\"))}\" required></label>\n    <label for=\"si-pass\">Reviewer passcode<input type=\"password\" id=\"si-pass\" autocomplete=\"current-password\" required></label>\n    <button class=\"primary\" type=\"submit\" id=\"si-go\">Sign in</button>\n    <p class=\"small\" id=\"si-err\" style=\"color:var(--bad)\" role=\"alert\"></p>\n  </form>`;\n}\n\nconst monthSelect = (id) => `<select id=\"${id}\" aria-label=\"Month\">${S.cfg.months.map((m) => `<option value=\"${m}\" ${m === S.month ? \"selected\" : \"\"}>${esc(monthLabel(m))}</option>`).join(\"\")}</select>`;\n\nfunction viewReview() {\n  const q = S.queue;\n  const head = `<div class=\"row\" style=\"justify-content:space-between\">\n      <div><p class=\"eyebrow\">Marketing checks</p><h2>Review ${esc(monthLabel(S.month))}</h2></div>\n      <div class=\"row\">${monthSelect(\"month\")}\n        <select id=\"filter\" aria-label=\"Show\">${[\"Pending\", \"Approved\", \"Rejected\", \"All\"].map((f) => `<option ${f === S.filter ? \"selected\" : \"\"}>${f}</option>`).join(\"\")}</select>\n        <button class=\"ghost\" id=\"refresh\">Refresh</button></div>\n    </div>`;\n  if (!q) { loadQueue(); return head + `<div class=\"panel empty\"><span class=\"spinner\"></span> Loading entries…</div>`; }\n  const groups = new Map(); q.lines.forEach((l) => { if (!groups.has(l.responseId)) groups.set(l.responseId, []); groups.get(l.responseId).push(l); });\n  const rows = [...groups.values()].map((g) => {\n    const f = g[0];\n    const links = f.evidence.map((e) => /^https?:\\/\\//.test(e) ? `<a href=\"${esc(e)}\" target=\"_blank\" rel=\"noopener\">${esc(e.replace(/^https?:\\/\\/(www\\.)?/, \"\").slice(0, 60))}</a>` : esc(e)).join(\"<br>\");\n    return `<tr>\n      <td><b>${esc(f.name || f.empId)}</b><br><span class=\"muted small\">${esc(f.empId)}</span><br><span class=\"muted small num\">${esc(istTime(f.at))}</span></td>\n      <td class=\"links small\">${esc(f.brand)} · ${esc(f.entryType)}${f.postKey ? `<br>Post: ${esc(f.postKey)}` : \"\"}<br>${links || `<span class=\"flag\">No evidence</span>`}</td>\n      <td>${g.map((l) => `<div class=\"row\" style=\"gap:6px;margin-bottom:8px\">\n          <span style=\"min-width:120px\">${esc(SHORT[l.action] || l.action)} <b class=\"num\">${l.points}</b></span>\n          ${q.finalised ? `<span class=\"chip\">${esc(l.decision)}</span>` : `\n          <button class=\"ghost ok-btn ${l.decision === \"Approved\" ? \"on\" : \"\"}\" data-id=\"${esc(l.id)}\" data-d=\"Approved\" aria-label=\"Approve ${esc(SHORT[l.action])}\">✓ Approve</button>\n          <button class=\"ghost bad-btn ${l.decision === \"Rejected\" ? \"on\" : \"\"}\" data-id=\"${esc(l.id)}\" data-d=\"Rejected\" aria-label=\"Reject ${esc(SHORT[l.action])}\">✕ Reject</button>`}\n          ${l.flags.map((x) => `<span class=\"flag\">${esc(flagText(x))}</span>`).join(\"\")}\n          ${l.reviewedBy && l.decision !== \"Pending\" ? `<span class=\"muted small\">by ${esc(l.reviewedBy)}</span>` : \"\"}\n          ${l.note ? `<span class=\"muted small\">“${esc(l.note)}”</span>` : \"\"}</div>`).join(\"\")}\n        ${q.finalised ? \"\" : `<div class=\"row\" style=\"gap:6px\">\n          <button class=\"ghost\" data-all=\"${esc(f.responseId)}\">Approve all without flags</button>\n          <button class=\"ghost\" data-reject-all=\"${esc(f.responseId)}\">Reject all with a note…</button></div>`}</td>\n    </tr>`;\n  }).join(\"\");\n  return `<div class=\"stack\">${head}\n    <div class=\"panel stack\">\n      <h3>Month end</h3>\n      ${q.finalised ? `<p>${esc(monthLabel(S.month))} is finalised. Its entries are locked; see the Leaderboard & winners tab.</p>` :\n        S.month >= S.cfg.month ? `<p class=\"muted\">Entries close at 11:59 PM IST on the last day. Winners are due by working day ${S.cfg.workingDays[2]} (${esc(q.winnersDue)}).</p>` :\n        `<p>${q.pending ? `<b>${q.pending}</b> entries still need a decision before winners can be picked.` : \"Every entry has a decision.\"} Winners are due by ${esc(q.winnersDue)}.</p>`}\n      ${q.finalised ? \"\" : S.confirm ? `<div class=\"row\"><button class=\"primary\" id=\"finalConfirm\">Yes, confirm winners</button><button class=\"secondary\" id=\"finalCancel\">Cancel</button><span class=\"small muted\">Runs the tie-break draw, makes certificates and Gmail drafts, and locks the month.</span></div>`\n        : `<div class=\"row\"><button class=\"primary\" id=\"final\" ${q.canFinalise ? \"\" : \"disabled\"}>Confirm winners</button></div>`}\n    </div>\n    ${rows ? `<div class=\"tablebox\"><table><thead><tr><th>Person</th><th>Evidence</th><th>Decide each line</th></tr></thead><tbody>${rows}</tbody></table></div>`\n      : `<div class=\"panel empty\">Nothing ${S.filter === \"All\" ? \"\" : S.filter.toLowerCase() + \" \"}for ${esc(monthLabel(S.month))}.</div>`}\n  </div>`;\n}\n\nasync function loadQueue() {\n  try { S.queue = await api(\"apiReviewQueue\", S.pass, S.month, S.filter); }\n  catch (e) { handleAuth(e); S.queue = { lines: [], pending: 0, finalised: false, canFinalise: false, winnersDue: \"\" }; }\n  if (S.tab === \"review\") render();\n}\n\nasync function decide(list) {\n  try {\n    await api(\"apiDecide\", S.pass, S.name, list);\n    list.forEach((d) => { const l = S.queue.lines.find((x) => x.id === d.id); if (l) { l.decision = d.decision; l.reviewedBy = S.name; if (d.note !== undefined) l.note = d.note; } });\n    render(); loadQueue();\n  } catch (e) { handleAuth(e); toast(e.message); }\n}\n\nfunction viewPosts() {\n  const list = S.cfg.posts;\n  return `<div class=\"grid2\">\n    <form class=\"panel stack\" id=\"postForm\" novalidate>\n      <div><p class=\"eyebrow\">Daily</p><h2>Add today's post</h2><p class=\"muted small\" style=\"margin-top:6px\">Employees see these on their page. Engagement on links not in this list is flagged.</p></div>\n      <label for=\"p-url\">Post link<input type=\"url\" id=\"p-url\" placeholder=\"https://www.instagram.com/p/…\"></label>\n      <label for=\"p-label\">Short label <span class=\"hint\">Optional</span><input type=\"text\" id=\"p-label\" maxlength=\"80\" placeholder=\"Garam masala reel\"></label>\n      <label for=\"p-brand\">Brand<select id=\"p-brand\">${S.cfg.brands.map((b) => `<option>${b}</option>`).join(\"\")}</select></label>\n      <button class=\"primary\" type=\"submit\" id=\"p-go\">Add post</button>\n      <p class=\"muted small\">To fix or remove a post, edit the Posts tab in the Google Sheet.</p>\n    </form>\n    <div class=\"tablebox\"><table><thead><tr><th>Date</th><th>Post</th></tr></thead><tbody>\n      ${list.length ? list.map((p) => `<tr><td class=\"num\">${esc(p.date)}</td><td class=\"links small\">${esc(p.brand)}${p.label ? \" · \" + esc(p.label) : \"\"}<br><a href=\"${esc(p.url)}\" target=\"_blank\" rel=\"noopener\">${esc(p.key)}</a></td></tr>`).join(\"\") : `<tr><td colspan=\"2\" class=\"empty\">No posts yet.</td></tr>`}\n    </tbody></table></div>\n  </div>`;\n}\n\nfunction viewBoard() {\n  const b = S.board;\n  const head = `<div class=\"row\" style=\"justify-content:space-between\"><div><p class=\"eyebrow\">Approved points only</p><h2>${esc(monthLabel(S.month))}</h2></div>${monthSelect(\"bmonth\")}</div>`;\n  if (!b) { api(\"apiLeaderboard\", S.month).then((r) => { S.board = r; if (S.tab === \"board\") render(); }, (e) => toast(e.message)); return head + `<div class=\"panel empty\"><span class=\"spinner\"></span></div>`; }\n  return `<div class=\"stack\">${head}\n    ${b.winners.length ? `<div class=\"notice ok\"><b>Winners confirmed.</b> Rewards are tracked in the Winners tab of the sheet.</div><div class=\"tablebox\"><table><thead><tr><th>Rank</th><th>Winner</th><th>Prize</th></tr></thead><tbody>\n      ${b.winners.map((w) => `<tr><td class=\"pos\">${esc(w.rank)}</td><td><b>${esc(w.name)}</b></td><td class=\"prize\">${esc(w.prize)}<br><span class=\"muted small\">${esc(w.detail)}${w.useBy ? \" · use by \" + esc(w.useBy) : \"\"}</span></td></tr>`).join(\"\")}</tbody></table></div>` : \"\"}\n    ${b.rows.length ? `<div class=\"tablebox\"><table><thead><tr><th>#</th><th>Name</th><th class=\"n\">Points</th><th class=\"n\">Days</th><th class=\"n\">Posts</th><th>Prize</th></tr></thead><tbody>\n      ${b.rows.map((r) => `<tr><td class=\"pos\">${r.position || \"\"}</td><td><b>${esc(r.name)}</b></td><td class=\"n\"><b>${r.points}</b></td><td class=\"n\">${r.activeDays}</td><td class=\"n\">${r.posts}</td>\n        <td>${r.prize ? esc(r.prize) : `<span class=\"muted small\">${r.toQualify} to qualify</span>`}${r.drawPending ? ` <span class=\"chip warn\">Tied</span>` : \"\"}</td></tr>`).join(\"\")}</tbody></table></div>`\n      : `<div class=\"panel empty\">No approved points yet.</div>`}\n  </div>`;\n}\n\nfunction handleAuth(e) { if (/passcode|attempts/i.test(e.message)) { S.pass = \"\"; ss.set(\"zc-pass\", \"\"); render(); } }\n\ndocument.addEventListener(\"click\", (ev) => {\n  const t = ev.target.closest(\"button\"); if (!t) return;\n  if (t.dataset.tab) { S.tab = t.dataset.tab; S.board = null; render(); }\n  else if (t.id === \"signout\") { S.pass = \"\"; ss.set(\"zc-pass\", \"\"); render(); }\n  else if (t.id === \"refresh\") { S.queue = null; render(); }\n  else if (t.dataset.id) { const l = S.queue.lines.find((x) => x.id === t.dataset.id); decide([{ id: t.dataset.id, decision: l && l.decision === t.dataset.d ? \"Pending\" : t.dataset.d }]); }\n  else if (t.dataset.all) {\n    const list = S.queue.lines.filter((l) => l.responseId === t.dataset.all && !l.flags.length && l.decision === \"Pending\").map((l) => ({ id: l.id, decision: \"Approved\" }));\n    list.length ? decide(list) : toast(\"Every line here has a flag. Decide them one by one.\");\n  }\n  else if (t.dataset.rejectAll) {\n    const row = t.closest(\"td\"); let box = row.querySelector(\".rejectBox\");\n    if (!box) { row.insertAdjacentHTML(\"beforeend\", `<div class=\"row rejectBox\" style=\"gap:6px;margin-top:8px\"><input type=\"text\" placeholder=\"Reason the employee will see\" aria-label=\"Reason\"><button class=\"ghost bad-btn\" data-reject-go=\"${esc(t.dataset.rejectAll)}\">Reject all</button></div>`); row.querySelector(\".rejectBox input\").focus(); }\n  }\n  else if (t.dataset.rejectGo) {\n    const note = t.parentElement.querySelector(\"input\").value.trim();\n    decide(S.queue.lines.filter((l) => l.responseId === t.dataset.rejectGo).map((l) => ({ id: l.id, decision: \"Rejected\", note })));\n  }\n  else if (t.id === \"final\") { S.confirm = true; render(); }\n  else if (t.id === \"finalCancel\") { S.confirm = false; render(); }\n  else if (t.id === \"finalConfirm\") {\n    t.disabled = true; t.innerHTML = `<span class=\"spinner\"></span> Working…`;\n    api(\"apiFinalise\", S.pass, S.month).then((b) => { S.confirm = false; S.board = b; S.queue = null; S.tab = \"board\"; toast(\"Winners confirmed. Check your Gmail drafts.\"); render(); },\n      (e) => { S.confirm = false; toast(e.message); render(); });\n  }\n});\ndocument.addEventListener(\"change\", (ev) => {\n  const t = ev.target;\n  if (t.id === \"month\" || t.id === \"bmonth\") { S.month = t.value; S.queue = null; S.board = null; S.confirm = false; render(); }\n  else if (t.id === \"filter\") { S.filter = t.value; S.queue = null; render(); }\n});\ndocument.addEventListener(\"submit\", async (ev) => {\n  ev.preventDefault();\n  if (ev.target.id === \"signinForm\") {\n    const name = $(\"#si-name\").value.trim(), pass = $(\"#si-pass\").value;\n    if (!name) { $(\"#si-err\").textContent = \"Enter your name.\"; return; }\n    $(\"#si-go\").disabled = true; $(\"#si-err\").textContent = \"\";\n    try { S.cfg = await api(\"apiReviewSignIn\", pass); S.pass = pass; S.name = name; S.month = S.cfg.month; ss.set(\"zc-pass\", pass); ss.set(\"zc-name\", name); render(); }\n    catch (e) { $(\"#si-err\").textContent = e.message; $(\"#si-go\").disabled = false; }\n  } else if (ev.target.id === \"postForm\") {\n    $(\"#p-go\").disabled = true;\n    try { S.cfg.posts = await api(\"apiAddPost\", S.pass, $(\"#p-url\").value.trim(), $(\"#p-brand\").value, $(\"#p-label\").value.trim()); toast(\"Post added.\"); render(); }\n    catch (e) { handleAuth(e); toast(e.message); $(\"#p-go\").disabled = false; }\n  }\n});\n\n(async function boot() {\n  const pass = ss.get(\"zc-pass\");\n  if (pass) {\n    try { S.cfg = await api(\"apiReviewSignIn\", pass); S.pass = pass; S.name = ss.get(\"zc-name\") || \"Reviewer\"; S.month = S.cfg.month; } catch (e) { ss.set(\"zc-pass\", \"\"); }\n  }\n  render();\n})();\n</script>\n</body>\n</html>\n"
};
