 (e) {} },\n  del(k) { try { localStorage.removeItem(k); } catch (e) {} }\n};\nconst $ = (s) => document.querySelector(s);\nconst esc = (s) => String(s == null ? \"\" : s).replace(/[&<>\"']/g, (c) => ({ \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", '\"': \"&quot;\", \"'\": \"&#39;\" }[c]));\nconst monthLabel = (mk) => { const [y, m] = mk.split(\"-\").map(Number); return new Date(Date.UTC(y, m - 1, 15)).toLocaleString(\"en-IN\", { month: \"long\", year: \"numeric\", timeZone: \"UTC\" }); };\nconst istTime = (ms) => new Date(ms).toLocaleString(\"en-IN\", { timeZone: \"Asia/Kolkata\", day: \"numeric\", month: \"short\", hour: \"2-digit\", minute: \"2-digit\" });\nfunction toast(msg) { const t = $(\"#toast\"); t.textContent = msg; t.hidden = false; clearTimeout(toast.h); toast.h = setTimeout(() => (t.hidden = true), 3500); }\nconst SHORT = { LIKE: \"Like\", COMMENT: \"Comment\", SOCIAL_SHARE: \"Share\", WA_STATUS: \"WA Status\", FRIENDS_GROUP: \"Friends/group\", HELPFUL_REPLY: \"Helpful reply\", ORIGINAL_POST: \"Original post\", ORIGINAL_REEL: \"Original Reel\", FACTORY_VIDEO: \"Factory video\", FACTORY_REEL: \"Factory Reel\", QUORA_ANSWER: \"Quora\" };\n\nconst TABS = [[\"submit\", \"Send proof\"], [\"posts\", \"Today's posts\"], [\"board\", \"Leaderboard\"], [\"mine\", \"My points\"], [\"rules\", \"How it works\"]];\n\nfunction render() {\n  $(\"#who\").innerHTML = S.emp ? `<span class=\"chip\">${esc(S.emp.name || S.emp.id)}</span><button class=\"ghost\" id=\"signout\">Sign out</button>` : \"\";\n  $(\"#tabs\").innerHTML = TABS.map(([k, l]) => `<button role=\"tab\" id=\"tab-${k}\" data-tab=\"${k}\" aria-selected=\"${S.tab === k}\">${l}</button>`).join(\"\");\n  if (!S.cfg) return;\n  const needsSignIn = (S.tab === \"submit\" || S.tab === \"mine\") && !S.emp;\n  $(\"#view\").innerHTML = needsSignIn ? viewSignIn() : { submit: viewSubmit, posts: viewPosts, board: viewBoard, mine: viewMine, rules: viewRules }[S.tab]();\n  if (S.tab === \"submit\" && S.emp) syncForm(